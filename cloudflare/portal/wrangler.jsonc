{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saldo-express-portal",
  "account_id": "ebdaa532a0c27ffc2148d1598a7f774b",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [
    { "pattern": "portal.saldoexpressnicaragua.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saldo-express-staging",
      "database_id": "1ac8d941-9732-40a9-a757-9dc6e6c35490",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "saldo-express-kyc-staging" },
  ],
  "vars": {
    "APP_URL": "https://portal.saldoexpressnicaragua.com",
    "MAINTENANCE_MODE": "false",
    "REGISTRATION_OPEN": "true",
    "ADMIN_SETUP_OPEN": "false",
    "ADMIN_REQUIRE_MFA": "true",
    "KYC_OPEN": "true",
    "EMAIL_PROVIDER": "resend",
    "TURNSTILE_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFFO60wl440m0CeE",
    "EMAIL_FROM": "Saldo Express <cuentas@saldoexpressnicaragua.com>",
    "SUPPORT_EMAIL": "soportesaldoexpress@gmail.com",
    "WHATSAPP_PROVIDER": "disabled",
    "WHATSAPP_GRAPH_VERSION": "v23.0",
    "WHATSAPP_TEMPLATE_NAME": "nuevo_ticket_saldo_express",
    "WHATSAPP_TEMPLATE_LANGUAGE": "es",
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    // App metrics and security events omit URLs, auth tokens and query parameters.
    // Automatic traces can capture reset tokens in paths and SQL parameters.
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
